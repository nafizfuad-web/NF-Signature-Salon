# NF Signature Salon — Client environment variables
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the .env file (it is gitignored). Only commit .env.example.

# Base URL of the SalonBook Express API.
# Used by services/api/ to build request URLs and resolve uploaded images.
VITE_API_BASE_URL=http://localhost:5000/api

# Only the excluded admin preview still reads development fixtures.
# Customer-facing features always use the real API (services, bookings,
# dashboard, profile and avatar uploads).
VITE_USE_MOCK_DATA=true

# Public Google OAuth client ID. The matching client ID, secret and callback
# URL must also be configured in salonbook-server/.env. The Google button is
# hidden while this value is empty.
VITE_GOOGLE_CLIENT_ID=

# The interactive location map uses OpenStreetMap + Leaflet — no API key needed.
# Configure the confirmed street address only when the salon owner provides it.
# Pabna city centre is used as an approximate temporary map location otherwise.
VITE_SALON_ADDRESS=
VITE_SALON_POSTAL_CODE=
# Configure coordinates only when verified for this salon business location.
VITE_SALON_LATITUDE=
VITE_SALON_LONGITUDE=
# Add only owner-confirmed business contact details and opening hours.
VITE_SALON_PHONE=
VITE_SALON_EMAIL=
# Add social profile URLs only after the owner confirms the official accounts.
VITE_SALON_INSTAGRAM_URL=
VITE_SALON_FACEBOOK_URL=
VITE_SALON_TIKTOK_URL=
# Opening hours are shown only for days with a configured value.
VITE_SALON_HOURS_SUNDAY=
VITE_SALON_HOURS_MONDAY=
VITE_SALON_HOURS_TUESDAY=
VITE_SALON_HOURS_WEDNESDAY=
VITE_SALON_HOURS_THURSDAY=
VITE_SALON_HOURS_FRIDAY=
VITE_SALON_HOURS_SATURDAY=
